            </KeyedObject>
        </LinearAnimation>

        <!-- Stretch, 150 frames: the neck grows and leans forward, overshoots, holds, the head nods, back down. -->
        <LinearAnimation duration="150" name="Stretch" id="4:3">
            <KeyedObject objectId="1:10">
                <KeyedProperty property="y"><KeyFrameDouble value="462" frame="0"/></KeyedProperty>
