        </Node>

        <StateMachine name="Dino" id="3:40">
            <StateMachineTrigger name="happy" id="3:1"/>
            <StateMachineTrigger name="stretch" id="3:2"/>
            <StateMachineBool name="running" id="3:3"/>
            <StateMachineBool name="airborne" id="3:4"/>
            <StateMachineBool name="ducking" id="3:5"/>

            <!-- Body: idle until poked. Hover hops, a press stretches the neck; both settle back to idle. Running trots in place until it stops. -->
            <StateMachineLayer name="Body" id="3:10">
                <AnyState x="0" y="-150"/>
                <ExitState x="400" y="-150"/>
                <EntryState x="0" y="0"><StateTransition stateToId="3:11"/></EntryState>
                <AnimationState x="200" y="0" animationId="4:1" id="3:11">
                    <StateTransition stateToId="3:14" duration="150"><TransitionBoolCondition inputId="3:3" opValue="equal"/></StateTransition>
                    <StateTransition stateToId="3:13" duration="120"><TransitionTriggerCondition inputId="3:2"/></StateTransition>
                    <StateTransition stateToId="3:12" duration="120"><TransitionTriggerCondition inputId="3:1"/></StateTransition>
                </AnimationState>
                <AnimationState x="400" y="-60" animationId="4:2" reset="true" id="3:12">
                    <StateTransition stateToId="3:14" duration="150"><TransitionBoolCondition inputId="3:3" opValue="equal"/></StateTransition>
                    <StateTransition stateToId="3:13" duration="120"><TransitionTriggerCondition inputId="3:2"/></StateTransition>
                    <StateTransition stateToId="3:11" duration="200" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
                <AnimationState x="400" y="60" animationId="4:3" reset="true" id="3:13">
                    <StateTransition stateToId="3:14" duration="150"><TransitionBoolCondition inputId="3:3" opValue="equal"/></StateTransition>
                    <StateTransition stateToId="3:11" duration="200" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
                <AnimationState x="200" y="150" animationId="4:6" id="3:14">
                    <StateTransition stateToId="3:11" duration="150"><TransitionBoolCondition inputId="3:3" opValue="notEqual"/></StateTransition>
                    <StateTransition stateToId="3:15" duration="80"><TransitionBoolCondition inputId="3:4" opValue="equal"/></StateTransition>
                    <StateTransition stateToId="3:16" duration="80"><TransitionBoolCondition inputId="3:5" opValue="equal"/></StateTransition>
                </AnimationState>
                <AnimationState x="200" y="270" animationId="4:8" id="3:16">
                    <StateTransition stateToId="3:11" duration="150"><TransitionBoolCondition inputId="3:3" opValue="notEqual"/></StateTransition>
                    <StateTransition stateToId="3:15" duration="80"><TransitionBoolCondition inputId="3:4" opValue="equal"/></StateTransition>
                    <StateTransition stateToId="3:14" duration="100"><TransitionBoolCondition inputId="3:5" opValue="notEqual"/></StateTransition>
                </AnimationState>
                <AnimationState x="400" y="150" animationId="4:7" id="3:15">
                    <StateTransition stateToId="3:11" duration="150"><TransitionBoolCondition inputId="3:3" opValue="notEqual"/></StateTransition>
                    <StateTransition stateToId="3:14" duration="100"><TransitionBoolCondition inputId="3:4" opValue="notEqual"/></StateTransition>
                </AnimationState>
            </StateMachineLayer>

            <!-- Blink: after every blink, wait a random 2, 4 or 6 seconds; now and then blink twice. -->
            <StateMachineLayer name="Blink" id="3:20">
                <AnyState x="0" y="-150"/>
                <ExitState x="600" y="-150"/>
                <EntryState x="0" y="0"><StateTransition stateToId="3:22"/></EntryState>
                <AnimationState x="200" y="-90" animationId="4:11" reset="true" id="3:21">
                    <StateTransition stateToId="3:24" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
                <AnimationState x="200" y="0" animationId="4:12" reset="true" id="3:22">
                    <StateTransition stateToId="3:24" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
                <AnimationState x="200" y="90" animationId="4:13" reset="true" id="3:23">
                    <StateTransition stateToId="3:24" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
                <AnimationState x="400" y="0" animationId="4:4" reset="true" random="true" id="3:24">
                    <StateTransition stateToId="3:21" randomWeight="2" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                    <StateTransition stateToId="3:22" randomWeight="3" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                    <StateTransition stateToId="3:23" randomWeight="2" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                    <StateTransition stateToId="3:25" randomWeight="1" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
                <AnimationState x="600" y="0" animationId="4:5" reset="true" id="3:25">
                    <StateTransition stateToId="3:22" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
            </StateMachineLayer>

            <StateMachineListenerSingle targetId="2:1" listenerTypeValue="enter" name="Hover hops" id="3:30">
                <ListenerTriggerChange inputId="3:1"/>
            </StateMachineListenerSingle>
            <StateMachineListenerSingle targetId="2:1" listenerTypeValue="down" name="Press stretches" id="3:31">
                <ListenerTriggerChange inputId="3:2"/>
            </StateMachineListenerSingle>
        </StateMachine>

        <!-- Idle, 3 s: breathe, sway the neck, tilt the head, wag the tail. -->
        <LinearAnimation loopValue="loop" duration="180" name="Idle" id="4:1">
            <KeyedObject objectId="1:10">
                <KeyedProperty property="scaleY"><KeyFrameDouble value="1" frame="0"/></KeyedProperty>
