                    <KeyFrameDouble value="0.448" frame="150"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Run, 0.4 s loop: a trot in place. Diagonal legs swing together (Leg0 with Leg3, Leg1 with Leg2), the body bobs once
             per step, the neck leans forward and the tail swings against the stride. -->
        <LinearAnimation loopValue="loop" duration="24" name="Run" id="4:6">
            <KeyedObject objectId="1:10">
                <KeyedProperty property="y">
                    <KeyFrameDouble value="462" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.7" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="455" frame="6" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.7" y2="1"/></KeyFrameDouble>
