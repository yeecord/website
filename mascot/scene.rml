            <!-- Blink: after every blink, wait a random 2, 4 or 6 seconds; now and then blink twice. -->
            <StateMachineLayer name="Blink" id="3:20">
                <AnyState x="0" y="-150"/>
                <ExitState x="600" y="-150"/>
                <EntryState x="0" y="0"><StateTransition stateToId="3:22"/></EntryState>
                <AnimationState x="200" y="-90" animationId="4:11" reset="true" id="3:21">
