        <!-- Empty timelines the blink layer waits on. -->
        <LinearAnimation duration="120" name="Wait 2s" id="4:11"/>
        <LinearAnimation duration="240" name="Wait 4s" id="4:12"/>
        <LinearAnimation duration="360" name="Wait 6s" id="4:13"/>
