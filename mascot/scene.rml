        </LinearAnimation>

        <!-- Blinks squash the eyes' own bone, so they close in place whatever the head is doing. -->
        <LinearAnimation duration="10" name="Blink" id="4:4">
            <KeyedObject objectId="1:9">
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
