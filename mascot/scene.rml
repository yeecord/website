        <!-- Duck, 0.4 s loop: the trot with the neck stretched forward from the shoulders, like a galloping horse's, and the head
             tipped nose-down as a horse charges, so the head passes under mid-height flyers. -->
        <LinearAnimation loopValue="loop" duration="24" name="Duck" id="4:8">
