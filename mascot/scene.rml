                </Fill>
                <Fill fillRule="clockwise" name="Shade">
                    <SolidColor colorValue="4D24A63F" name="Color"/>
                    <Feather inner="true" strength="14" offsetX="-12" offsetY="-10" name="Feather"/>
                </Fill>
            </Shape>

