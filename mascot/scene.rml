        <!-- Jump: held while off the ground. Front legs reach forward, back legs push back, the tail lifts. -->
        <LinearAnimation loopValue="loop" duration="12" name="Jump" id="4:7">
            <KeyedObject objectId="1:10">
                <KeyedProperty property="y"><KeyFrameDouble value="462" frame="0"/></KeyedProperty>
