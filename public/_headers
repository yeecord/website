/*
    Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
    Cache-Control: no-cache

# hash 檔名 content-addressed，可永久快取。其餘（HTML、/RSC/* payload）一律
# no-cache 強制 revalidate，避免瀏覽器快取住舊 build 的 payload，
# 造成 Waku build-id mismatch 每次導航都 reload
/assets/*
    Cache-Control: public, max-age=31536000, immutable
