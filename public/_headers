/*
    Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
    Cache-Control: no-cache

# hash 檔名 content-addressed，同 hash 同內容，可永久快取；其餘（HTML、/RSC/* payload）
# 一律 no-cache 強制 revalidate，避免瀏覽器快取住舊 build 的 payload 或 edge 送舊/404 chunk，
# 造成 Waku build-id mismatch / vite:preloadError 無限 reload
/assets/*
    Cache-Control: public, max-age=31536000, immutable

# preview 站不進搜尋索引；master 轉正到 yeecord.com 後這條自動不匹配
https://next.yeecord.com/*
    X-Robots-Tag: noindex
